# Astrolabe Environment Configuration Example
# Copy this file to .env for local deployment and testing scripts.
# WARNING: Do NOT place real secrets or production keys here.

# Stellar Network & RPC
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Development & Testnet Accounts (Dummy keys for local reference)
DEPLOYER_SECRET_KEY=SBEXAMPLESECRETKEYFORTESTNETDEPLOYMENTONLY000000000000000000
AUTHORITY_SECRET_KEY=SBEXAMPLEAUTHORITYKEYFORSCHEMAREGISTRATION00000000000000000

# Contract Addresses (Populated after deploying with Soroban CLI)
SCHEMA_REGISTRY_CONTRACT_ID=CAYUJL5VPIVDBAGXAQ3FTOUJ4LICWV6IFKIMTRPAJB7ZS5FMRRI3M5EC
ATTESTATION_CONTRACT_ID=CB2773G3PKQVSECFXTM2Q65W2XJLMWGQXC5UTFBQEPHYPAGUEXEYBMW4
